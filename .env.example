# Banco de dados — Postgres (Neon). Na Vercel é preenchido pela integração Neon (Storage).
# Sem DATABASE_URL, em desenvolvimento o app usa PGlite (Postgres em WASM) em ./.data/pglite.
DATABASE_URL=

# Executa as migrations durante o build (defina "1" apenas no projeto da Vercel deste app).
MIGRATE_ON_BUILD=

# Usuário inicial: criado automaticamente na migração se ainda não existir nenhum usuário.
# Depois do primeiro acesso, troque a senha em Configurações e pode apagar ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Vercel Cron envia "Authorization: Bearer $CRON_SECRET" para /api/cron/daily
CRON_SECRET=

# Desenvolvimento local sem DATABASE_URL: diretório do PGlite ("memory" = em memória)
# PGLITE_DIR=./.data/pglite
