# Banco de dados (Neon Postgres — crie pela aba Storage/Marketplace da Vercel; ela preenche esta variável)
DATABASE_URL=

# Senha de acesso ao app (usuário único). Sem ela, em produção a tela de login avisa que falta configurar.
APP_PASSWORD=
# Opcional: segredo para assinar o cookie de sessão (padrão: derivado da senha)
SESSION_SECRET=

# Open Finance via Pluggy — https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional: recebe avisos da Pluggy quando chegam transações novas (qualquer texto aleatório longo)
PLUGGY_WEBHOOK_SECRET=
# Opcional: mostra os bancos de teste (sandbox) da Pluggy no widget de conexão
NEXT_PUBLIC_PLUGGY_SANDBOX=0

# Vercel Cron: a Vercel envia "Authorization: Bearer $CRON_SECRET" para /api/cron/sync
CRON_SECRET=

# Desenvolvimento local sem DATABASE_URL: PGlite em ./.data/pglite (ou "memory")
# PGLITE_DIR=./.data/pglite
